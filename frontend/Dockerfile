FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_URL=http://localhost:8000
ARG VITE_ADMIN_EMAIL=admin@example.com
ARG VITE_ADMIN_PASSWORD=AdminPass123!
ARG VITE_TEST_USER_EMAIL=test@example.com
ARG VITE_TEST_USER_PASSWORD=TestPass123!
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ADMIN_EMAIL=$VITE_ADMIN_EMAIL
ENV VITE_ADMIN_PASSWORD=$VITE_ADMIN_PASSWORD
ENV VITE_TEST_USER_EMAIL=$VITE_TEST_USER_EMAIL
ENV VITE_TEST_USER_PASSWORD=$VITE_TEST_USER_PASSWORD
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
